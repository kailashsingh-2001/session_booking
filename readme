│   └── errorHandler.ts        # Centralized error handling and 404 handler
├── models/
│   ├── User.ts
│   ├── Teacher.ts
│   └── Session.ts
├── routes/
│   └── index.ts               # Route definitions
├── utils/
│   ├── AppError.ts            # Custom error class
│   ├── asyncHandler.ts        # Catches errors from async controllers
│   └── validators.ts          # Input validation helpers
├── app.ts                     # Express app setup
├── server.ts                  # Entry point
├── .env.example
├── package.json
├── tsconfig.json
└── postman_collection.json
```

